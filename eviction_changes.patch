+    orc.last_eviction_time = time.monotonic() - 1.0
+
+    fake_task = MagicMock()
+    with patch("asyncio.create_task", return_value=fake_task) as mock_create:
+        orc._maybe_schedule_cycle()
+        mock_create.assert_called_once()
